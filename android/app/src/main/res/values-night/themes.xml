<resources>
    <color name="hf_bg">#0F1726</color>
    <style name="Theme.Homefront" parent="android:Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@color/hf_bg</item>
        <item name="android:colorAccent">#FFC94D</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
    <style name="Theme.Homefront.Touchpad" parent="android:Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@color/hf_ink</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
